datasource db{
    provider = "postgresql"
    url = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

enum Role {
  Beginner
  Experienced
}

model User {
  id String @id @default(uuid())
  email String @unique
  username String @unique
  passwordHash String
  role Role @default(Beginner)
  createdAt DateTime @default(now())
  tracks Track[]
  mixSessions  MixSession[]
  settings UserSettings?
}

model Track {
  id String @id @default(uuid())
  title String
  artist String
  album String?
  duration Int         // duration in seconds
  fileUrl String
  artworkUrl String?
  ownerId String? // null = starter track, visible to every user
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mixSessionsAsTrackA MixSession[] @relation("TrackA")
  mixSessionsAsTrackB MixSession[] @relation("TrackB")
}

model MixSession {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackAId String
  trackA Track @relation("TrackA", fields: [trackAId], references: [id], onDelete: Cascade)
  trackBId String
  trackB Track @relation("TrackB", fields: [trackBId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt DateTime?
  effectUsed String?
}

model UserSettings {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredEffect String @default("lowpass")
  gestureSensitivity Float @default(1.0)
}